# local server
PORT=8787
APP_SECRET=replace-with-a-long-random-string
DEMO_MODE=1

# Supabase (leave blank for demo mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# first admin account: set this email, sign up, then it becomes admin on /api/me
ADMIN_EMAIL=

# AI (OpenAI-compatible; DeepSeek default)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Docker runner image (build with: docker build -t c-course-runner runner/)
RUNNER_IMAGE=c-course-runner:latest
C_COMPILER=clang
